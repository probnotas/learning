# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.

# Required for the AI features (video tests, notes check, Ask AI). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Strongly recommended on a public deployment: without it, anyone who finds your URL
# can use the AI features on your API key. The app asks for it once per browser.
LEARNLAB_ACCESS_CODE=
